# Server
PORT=7000

# MongoDB
MONGODB_URI=

# Cloudinary (product image uploads) — set real values in .env, never commit them
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deployed frontend origin (Netlify URL) used to restrict CORS in production.
# Leave empty for local development to allow all origins.
FRONTEND_URL=
